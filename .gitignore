# Original Olist files and download archives stay local.
/data/raw/*
!/data/raw/.gitkeep
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.gz

# Local credentials and connection files.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.pgpass
.pgpass.*
*.pgpass
pgpass.conf
pg_service.conf

# Python virtual environments and generated bytecode.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]

# Temporary and operating-system files.
*.tmp
*.temp
*.log
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Local learning exports and disposable development intermediates.
# Keep the original tracked Olist 1.0 dashboard assets.
/output/
/tmp/

# Power BI local caches and user-specific settings stay local.
**/.pbi/
*.pbix.lock
*.pbip.lock
