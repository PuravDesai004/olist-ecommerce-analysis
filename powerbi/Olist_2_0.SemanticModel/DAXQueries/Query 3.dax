EVALUATE
VAR Baseline =
VAR Checks = UNION(
ROW("Check", "orders", "Actual", COALESCE([Orders],0), "Expected", 99441),
ROW("Check", "delivered_orders", "Actual", COALESCE([Delivered Orders],0), "Expected", 96478),
ROW("Check", "item_sales_brl", "Actual", COALESCE(ROUND([Item Sales BRL],2),0), "Expected", 13591643.70),
ROW("Check", "freight_brl", "Actual", COALESCE(ROUND([Freight BRL],2),0), "Expected", 2251909.54),
ROW("Check", "payments_brl", "Actual", COALESCE(ROUND([Payment Value BRL],2),0), "Expected", 16008872.12),
ROW("Check", "paid_orders", "Actual", COALESCE([Orders With Payment],0), "Expected", 99440),
ROW("Check", "aov_brl", "Actual", COALESCE(ROUND([AOV BRL],2),0), "Expected", 160.99),
ROW("Check", "review_mean", "Actual", COALESCE(ROUND([Average Source Review Score],2),0), "Expected", 4.09),
ROW("Check", "delivery_mean_days", "Actual", COALESCE(ROUND([Average Delivery Days],2),0), "Expected", 12.56),
ROW("Check", "eligible_deliveries", "Actual", COALESCE([Eligible Delivered Orders],0), "Expected", 96470),
ROW("Check", "late_deliveries", "Actual", COALESCE([Late Orders],0), "Expected", 7826),
ROW("Check", "late_rate_percent", "Actual", COALESCE(ROUND(100*[Late Delivery %],2),0), "Expected", 8.11),
ROW("Check", "distinct_people", "Actual", COALESCE([Customers],0), "Expected", 96096),
ROW("Check", "returning_people", "Actual", COALESCE([Returning Customers],0), "Expected", 2997),
ROW("Check", "returning_percent", "Actual", COALESCE(ROUND(100*[Returning Customer %],2),0), "Expected", 3.12),
ROW("Check", "fact_item_rows", "Actual", COALESCE(COUNTROWS(FactItems),0), "Expected", 112650),
ROW("Check", "fact_payment_rows", "Actual", COALESCE(COUNTROWS(FactPayments),0), "Expected", 103886),
ROW("Check", "raw_review_rows", "Actual", COALESCE([Source Review Records],0), "Expected", 99224),
ROW("Check", "dim_product_rows", "Actual", COALESCE(COUNTROWS(DimProduct),0), "Expected", 32951),
ROW("Check", "dim_seller_rows", "Actual", COALESCE(COUNTROWS(DimSeller),0), "Expected", 3095),
ROW("Check", "date_rows", "Actual", COALESCE(COUNTROWS(DimDate),0), "Expected", 1096),
ROW("Check", "cohort_cells", "Actual", COALESCE(COUNTROWS(CohortRetention),0), "Expected", 278),
ROW("Check", "cohort_month_zero_people", "Actual", COALESCE(CALCULATE(SUM(CohortRetention[cohort_size]),CohortRetention[month_offset]=0),0), "Expected", 93358),
ROW("Check", "cohort_invalid_zero_cells", "Actual", COALESCE(COUNTROWS(FILTER(CohortRetention,CohortRetention[month_offset]=0 && CohortRetention[active_customers]<>CohortRetention[cohort_size])),0), "Expected", 0),
ROW("Check", "cohort_future_cells", "Actual", COALESCE(COUNTROWS(FILTER(CohortRetention,CohortRetention[activity_month]>=CohortRetention[observation_end])),0), "Expected", 0),
ROW("Check", "order_key_duplicates", "Actual", COALESCE(COUNTROWS(FactOrders)-DISTINCTCOUNT(FactOrders[order_id]),0), "Expected", 0),
ROW("Check", "customer_key_duplicates", "Actual", COALESCE(COUNTROWS(DimCustomer)-DISTINCTCOUNT(DimCustomer[customer_unique_id]),0), "Expected", 0),
ROW("Check", "product_key_duplicates", "Actual", COALESCE(COUNTROWS(DimProduct)-DISTINCTCOUNT(DimProduct[product_id]),0), "Expected", 0),
ROW("Check", "seller_key_duplicates", "Actual", COALESCE(COUNTROWS(DimSeller)-DISTINCTCOUNT(DimSeller[seller_id]),0), "Expected", 0),
ROW("Check", "category_key_duplicates", "Actual", COALESCE(COUNTROWS(DimCategory)-DISTINCTCOUNT(DimCategory[category_key]),0), "Expected", 0),
ROW("Check", "item_key_duplicates", "Actual", COALESCE(COUNTROWS(FactItems)-COUNTROWS(SUMMARIZE(FactItems,FactItems[order_id],FactItems[order_item_id])),0), "Expected", 0),
ROW("Check", "payment_key_duplicates", "Actual", COALESCE(COUNTROWS(FactPayments)-COUNTROWS(SUMMARIZE(FactPayments,FactPayments[order_id],FactPayments[payment_sequential])),0), "Expected", 0),
ROW("Check", "seller_order_key_duplicates", "Actual", COALESCE(COUNTROWS(FactSellerOrders)-COUNTROWS(SUMMARIZE(FactSellerOrders,FactSellerOrders[order_id],FactSellerOrders[seller_id])),0), "Expected", 0),
ROW("Check", "item_product_orphans", "Actual", COALESCE(COUNTROWS(EXCEPT(VALUES(FactItems[product_id]),VALUES(DimProduct[product_id]))),0), "Expected", 0),
ROW("Check", "item_seller_orphans", "Actual", COALESCE(COUNTROWS(EXCEPT(VALUES(FactItems[seller_id]),VALUES(DimSeller[seller_id]))),0), "Expected", 0),
ROW("Check", "order_person_orphans", "Actual", COALESCE(COUNTROWS(EXCEPT(VALUES(FactOrders[customer_unique_id]),VALUES(DimCustomer[customer_unique_id]))),0), "Expected", 0),
ROW("Check", "item_category_orphans", "Actual", COALESCE(COUNTROWS(EXCEPT(VALUES(FactItems[category_key]),VALUES(DimCategory[category_key]))),0), "Expected", 0),
ROW("Check", "review_row_reconciliation", "Actual", COALESCE(SUM(FactOrders[review_rows]),0), "Expected", COUNTROWS('public order_reviews')),
ROW("Check", "review_score_reconciliation", "Actual", COALESCE(SUM(FactOrders[review_score_sum]),0), "Expected", SUM('public order_reviews'[review_score])),
ROW("Check", "seller_sales_reconciliation", "Actual", COALESCE(ROUND(SUM(FactSellerOrders[seller_item_sales_brl]),2),0), "Expected", ROUND([Item Sales BRL],2)),
ROW("Check", "category_sales_reconciliation", "Actual", COALESCE(ROUND(SUM(FactCategoryOrders[category_item_sales_brl]),2),0), "Expected", ROUND([Item Sales BRL],2)),
ROW("Check", "item_source_reconciliation", "Actual", COALESCE(ROUND([Item Sales BRL],2),0), "Expected", ROUND(SUM('public order_items'[price]),2)),
ROW("Check", "payment_source_reconciliation", "Actual", COALESCE(ROUND([Payment Value BRL],2),0), "Expected", ROUND(SUM('public order_payments'[payment_value]),2)),
ROW("Check", "rfm_payment_reconciliation", "Actual", COALESCE(ROUND([RFM Monetary BRL],2),0), "Expected", ROUND(CALCULATE([Payment Value BRL],FactOrders[order_status]="delivered",FactOrders[has_payment]=TRUE(),FactOrders[order_purchase_timestamp]<DATE(2018,9,1)),2)),
ROW("Check", "active_bidirectional_relationships", "Actual", COALESCE(COUNTROWS(FILTER(INFO.VIEW.RELATIONSHIPS(),[IsActive]=TRUE() && [CrossFilteringBehavior]="BothDirections")),0), "Expected", 0),
ROW("Check", "raw_geolocation_rows_preserved", "Actual", COALESCE(COUNTROWS('public geolocation'),0), "Expected", 1000163)
)
RETURN ADDCOLUMNS(Checks,"Status",IF(ABS([Actual]-[Expected])<0.00001,"PASS","FAIL"))

VAR FilterChecks =
VAR Checks = UNION(
    ROW("Check","october_2017_sales","Actual",ROUND(CALCULATE([Item Sales BRL],DimDate[year_month]="2017-10"),2),"Expected",664219.43),
    ROW("Check","november_2017_sales","Actual",ROUND(CALCULATE([Item Sales BRL],DimDate[year_month]="2017-11"),2),"Expected",1010271.37),
    ROW("Check","november_growth_percent","Actual",ROUND(100*CALCULATE([Sales MoM %],DimDate[year_month]="2017-11"),2),"Expected",52.10),
    ROW("Check","health_beauty_sales","Actual",ROUND(CALCULATE([Item Sales BRL],DimCategory[Category]="health beauty"),2),"Expected",1258681.34),
    ROW("Check","category_does_not_allocate_payments","Actual",ROUND(CALCULATE([Payment Value BRL],DimCategory[Category]="health beauty"),2),"Expected",16008872.12),
    ROW("Check","credit_card_payments","Actual",ROUND(CALCULATE([Payment Method Value BRL],FactPayments[Payment method]="Credit card"),2),"Expected",12542084.19),
    ROW("Check","credit_card_transactions","Actual",CALCULATE([Payment Transactions],FactPayments[Payment method]="Credit card"),"Expected",76795),
    ROW("Check","high_value_active_people","Actual",CALCULATE([RFM Eligible People],DimCustomer[rfm_segment]="High value active"),"Expected",500),
    ROW("Check","ineligible_segment_not_in_rfm","Actual",COALESCE(CALCULATE([RFM Eligible People],DimCustomer[rfm_segment]="Not eligible"),0),"Expected",0),
    ROW("Check","high_value_active_monetary","Actual",ROUND(CALCULATE([RFM Monetary BRL],DimCustomer[rfm_segment]="High value active"),2),"Expected",183407.56),
    ROW("Check","main_cohort_m1_active","Actual",CALCULATE([Cohort Active Customers],CohortRetention[month_offset]=1,CohortRetention[cohort_month]>=DATE(2017,1,1),CohortRetention[cohort_month]<=DATE(2018,7,1)),"Expected",420),
    ROW("Check","main_cohort_m1_size","Actual",CALCULATE([Cohort Size],CohortRetention[month_offset]=1,CohortRetention[cohort_month]>=DATE(2017,1,1),CohortRetention[cohort_month]<=DATE(2018,7,1)),"Expected",86950),
    ROW("Check","top_seller_sales","Actual",ROUND(CALCULATE([Seller Item Sales BRL],DimSeller[seller_id]="4869f7a5dfa277a7dca6462dcf3b52b2"),2),"Expected",229472.63),
    ROW("Check","top_seller_orders","Actual",CALCULATE([Seller Orders],DimSeller[seller_id]="4869f7a5dfa277a7dca6462dcf3b52b2"),"Expected",1132),
    ROW("Check","seller_sp_sales","Actual",ROUND(CALCULATE([Seller Item Sales BRL],DimSeller[seller_state]="SP"),2),"Expected",8753396.21),
    ROW("Check","seller_state_preserves_whole_order_kpi","Actual",CALCULATE([Orders],DimSeller[seller_state]="SP"),"Expected",99441),
    ROW("Check","early_delivery_review_mean","Actual",ROUND(CALCULATE([Average Reviewed Order Score],FactOrders[Delivery bucket]="On time / early"),2),"Expected",4.29),
    ROW("Check","over_week_late_review_mean","Actual",ROUND(CALCULATE([Average Reviewed Order Score],FactOrders[Delivery bucket]="Over 7 days late"),2),"Expected",1.73)
)
RETURN ADDCOLUMNS(Checks,"Status",IF(ABS([Actual]-[Expected])<0.005,"PASS","FAIL"))

VAR AllChecks = UNION(Baseline,FilterChecks)
RETURN ROW("Checks",COUNTROWS(AllChecks),"Passed",COUNTROWS(FILTER(AllChecks,[Status]="PASS")),"Failed",COUNTROWS(FILTER(AllChecks,[Status]="FAIL")),"Failures",CONCATENATEX(FILTER(AllChecks,[Status]="FAIL"),[Check]&" actual="&[Actual]&" expected="&[Expected],"; "))

EVALUATE
VAR Checks = UNION(
    ROW("Check","october_2017_sales","Actual",ROUND(CALCULATE([Item Sales BRL],DimDate[year_month]="2017-10"),2),"Expected",664219.43),
    ROW("Check","november_2017_sales","Actual",ROUND(CALCULATE([Item Sales BRL],DimDate[year_month]="2017-11"),2),"Expected",1010271.37),
