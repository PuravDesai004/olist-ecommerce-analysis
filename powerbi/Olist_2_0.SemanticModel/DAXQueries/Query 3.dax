    ROW("Check","high_value_active_monetary","Actual",ROUND(CALCULATE([RFM Monetary BRL],DimCustomer[rfm_segment]="High value active"),2),"Expected",183407.56),
    ROW("Check","main_cohort_m1_active","Actual",CALCULATE([Cohort Active Customers],CohortRetention[month_offset]=1,CohortRetention[cohort_month]>=DATE(2017,1,1),CohortRetention[cohort_month]<=DATE(2018,7,1)),"Expected",420),
    ROW("Check","main_cohort_m1_size","Actual",CALCULATE([Cohort Size],CohortRetention[month_offset]=1,CohortRetention[cohort_month]>=DATE(2017,1,1),CohortRetention[cohort_month]<=DATE(2018,7,1)),"Expected",86950),
    ROW("Check","top_seller_sales","Actual",ROUND(CALCULATE([Seller Item Sales BRL],DimSeller[seller_id]="4869f7a5dfa277a7dca6462dcf3b52b2"),2),"Expected",229472.63),
    ROW("Check","top_seller_orders","Actual",CALCULATE([Seller Orders],DimSeller[seller_id]="4869f7a5dfa277a7dca6462dcf3b52b2"),"Expected",1132),
    ROW("Check","seller_sp_sales","Actual",ROUND(CALCULATE([Seller Item Sales BRL],DimSeller[seller_state]="SP"),2),"Expected",8753396.21),
