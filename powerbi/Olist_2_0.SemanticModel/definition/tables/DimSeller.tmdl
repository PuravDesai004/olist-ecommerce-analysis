		summarizeBy: none

	partition DimSeller = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "olist2"),
				    View = Source{[Schema="olist_analytics", Item="v_sellers"]}[Data]
				in
				    View

	annotation PBI_ResultType = Table
