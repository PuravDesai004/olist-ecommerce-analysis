	column seller_state
		dataType: string
		lineageTag: 19552f0f-0824-56f1-b060-1150c0d59d76
		summarizeBy: none
		sourceColumn: seller_state
		dataCategory: StateOrProvince

	column 'Seller label' = LEFT(DimSeller[seller_id], 8) & "..." & RIGHT(DimSeller[seller_id], 4)
