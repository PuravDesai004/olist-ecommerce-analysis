		sourceColumn: payment_difference_brl
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00

	column 'Delivery bucket' = IF(NOT(FactOrders[eligible_delivery]), "Ineligible", SWITCH(TRUE(), FactOrders[delay_days] <= 0, "On time / early", FactOrders[delay_days] <= 3, "1-3 days late", FactOrders[delay_days] <= 7, "3-7 days late", "Over 7 days late"))
		dataType: string
		summarizeBy: none
		sortByColumn: 'Delivery bucket order'

	column 'Delivery bucket order' = IF(NOT(FactOrders[eligible_delivery]), 4, SWITCH(TRUE(), FactOrders[delay_days] <= 0, 0, FactOrders[delay_days] <= 3, 1, FactOrders[delay_days] <= 7, 2, 3))
		dataType: int64
		isHidden
		summarizeBy: none

	partition FactOrders = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "olist2"),
				    View = Source{[Schema="olist_analytics", Item="v_orders"]}[Data]
				in
				    View

	annotation PBI_ResultType = Table
