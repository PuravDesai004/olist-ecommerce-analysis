	column purchase_date
		dataType: dateTime
		lineageTag: 9f806807-7380-5dc0-a143-bba4b29273d1
		summarizeBy: none
		sourceColumn: purchase_date
		formatString: dd MMM yyyy

		annotation UnderlyingDateTimeDataType = Date

	column 'Payment method' = SWITCH(FactPayments[payment_type], "credit_card", "Credit card", "debit_card", "Debit card", "boleto", "Boleto", "voucher", "Voucher", "not_defined", "Not defined", FactPayments[payment_type])
		dataType: string
		summarizeBy: none

	partition FactPayments = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "olist2"),
				    View = Source{[Schema="olist_analytics", Item="v_payments"]}[Data]
				in
				    View

	annotation PBI_ResultType = Table
