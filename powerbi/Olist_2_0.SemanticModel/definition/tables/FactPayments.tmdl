	column payment_installments
		dataType: int64
		lineageTag: c7fead70-ea47-5ff1-8f25-78a0248a8262
		summarizeBy: none
		sourceColumn: payment_installments

	column payment_value
		dataType: decimal
		lineageTag: 391878de-afca-5bc1-8162-8c051c9e9ab8
		summarizeBy: none
		sourceColumn: payment_value
		formatString: "R$" #,##0.00;("R$" #,##0.00);"R$" 0.00

	column customer_unique_id
		dataType: string
